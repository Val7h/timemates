  "new_endpoints": [
    {
      "method": "POST",
      "path": "/api/billing/create-checkout",
      "auth_required": true,
      "description": "Generate Stripe Checkout session URL",
      "returns": {
        "checkout_url": "string (Stripe-hosted checkout page)",
        "session_id": "string (for reference)"
      }
    },
    {
      "method": "GET",
      "path": "/api/billing/subscription",
      "auth_required": true,
      "description": "Get user's subscription status",
      "returns": {
        "plan": "string (e.g., 'premium')",
        "status": "string (active|canceled|past_due)",
        "is_active": "boolean",
        "current_period_end": "ISO string"
      }
    },
    {
      "method": "POST",
      "path": "/api/billing/cancel",
      "auth_required": true,
      "description": "Cancel user subscription",
      "returns": {
        "status": "string ('canceled')",
        "message": "string"
      }
    },
    {
      "method": "POST",
      "path": "/api/billing/webhooks/stripe",
      "auth_required": false,
      "description": "Receive Stripe webhook events",
      "webhook_verification": "Stripe signature validation"
    },
    {
      "method": "GET",
      "path": "/api/billing/public-key",
      "auth_required": false,
      "description": "Get Stripe public key for frontend",
      "returns": {
        "public_key": "string (pk_test_...)"
      }
    },
    {
      "method": "POST",
      "path": "/api/billing/portal",
      "auth_required": true,
      "description": "Create link to Stripe billing portal",
      "returns": {
        "portal_url": "string (Stripe-hosted portal)"
      }
    }
  ],

