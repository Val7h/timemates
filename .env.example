# ── TimeMates — Variáveis de ambiente ────────────────────────────────────────
# Copie para .env e preencha com seus valores reais.
# O servidor lê via os.getenv() — não precisa instalar python-dotenv.

# ── Gmail SMTP (Senha de App do Google) ──────────────────────────────────────
# 1. Ative a verificação em 2 etapas na conta Google
# 2. Acesse: https://myaccount.google.com/apppasswords
# 3. Crie uma senha para "E-mail / Windows" e cole abaixo
SMTP_USER=noreply.timemates@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── URL base (usada nos links dos e-mails) ───────────────────────────────────
BASE_URL=http://localhost:8765
# Produção: BASE_URL=https://timemates.app

# ── SMTP (padrão Gmail — só altere se usar outro provedor) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
